#!/usr/bin/env bash
# mgm — the mgm coding agent (pi under the hood) with the ~/localllm/mgm config, from ANY directory.
#   mgm                      interactive, in the current repo
#   mgm -p "prompt"          non-interactive
#   mgm --model litellm/claude-sonnet-5:high
# Config (extensions, packages, settings, sessions) lives in ~/localllm/mgm/.pi;
# secrets come from ~/localllm/.env and are exported so packages (pi-mcp-adapter) can use ${VAR}.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ -f "$ROOT/../.env" ]]; then set -a; source "$ROOT/../.env"; set +a; fi
if [[ -f "$ROOT/.env" ]]; then set -a; source "$ROOT/.env"; set +a; fi
export PI_CODING_AGENT_DIR="$ROOT/.pi"
exec "$ROOT/node_modules/.bin/pi" -a "$@"
