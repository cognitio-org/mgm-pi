#!/usr/bin/env bash
# kernal — the kernal coding agent (pi under the hood) with the ~/localllm/kernal config, from ANY directory.
#   kernal                      interactive, in the current repo
#   kernal -p "prompt"          non-interactive
#   kernal --model litellm/claude-sonnet-5:high
#   kernal --teleport <id>      pull a session pushed from another machine (see /teleport), then open it
# Config (extensions, packages, settings, sessions) lives in <bundle or checkout>/.pi;
# secrets come from ~/localllm/.env and are exported so packages (pi-mcp-adapter) can use ${VAR}.
set -euo pipefail
# kenv NAME: reads $KERNAL_<NAME>, falling back to the legacy $MGM_<NAME> (warns once per process
# per old name to stderr). Every shell script in this repo that reads a renamed env var defines the
# same small function; see .pi/extensions/_shared/env.ts for the TypeScript-side equivalent and
# docs/rename.md for when the fallback goes away.
_kenv_warned=""
kenv() {
  local name="$1" kv="KERNAL_$1" mv="MGM_$1"
  if [[ -n "${!kv:-}" ]]; then printf '%s' "${!kv}"; return 0; fi
  if [[ -n "${!mv:-}" ]]; then
    case " $_kenv_warned " in *" $name "*) ;; *) _kenv_warned="$_kenv_warned $name"; echo "$mv is now $kv; the old name stops working in a later release." >&2 ;; esac
    printf '%s' "${!mv}"; return 0
  fi
  return 1
}
# --- prune: begin (install.sh and bin/kernal carry byte-identical copies; tests/install.test.ts checks)
# prune_versions ROOT PREFIX PLATFORM KEEP DRY SESSIONS [PREVIOUS] [ALSO_KEEP]
# Removes old release bundles, ROOT/PREFIX-<semver>-PLATFORM, keeping KEEP of them: the one `current`
# points to, then PREVIOUS (the bundle `current` pointed to before this install, the rollback target),
# then the highest remaining versions by semver (0.1.10 > 0.1.9; a pre-release sorts below its
# release; pre-release tags compare as plain strings). Names are unique per platform, so there is no
# tie to break and modification times are never consulted. ALSO_KEEP (the bundle running this, for
# `kernal prune`) is never removed and does not count. DRY=1 reports without removing anything.
# Paranoid on purpose; any of these prunes NOTHING and says why (returning 1):
#   - KEEP is not a whole number >= 1; ROOT or ROOT/current cannot be resolved; current is not a
#     symlink to a correctly named bundle directly inside ROOT;
#   - any entry named PREFIX-* that is not a real directory with exactly that name pattern (a symlink,
#     a file, a stray name): something unexpected is in there and a human should look first.
# Bundles for another platform (a correctly named PREFIX-<semver>-<other platform>) are left alone,
# as is everything not named PREFIX-* (state/, .update-check.json, ...). A bundle is also kept when
# it holds a real (not linked) .pi/sessions with a file that is not byte-identical under SESSIONS.
# `rm -rf` does not follow symlinks inside what it removes, so a bundle's links into state/ go, state/
# does not. bash 3.2 safe: no associative arrays, no mapfile, no empty-array expansions.
_prune_semver_re='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$'
_prune_platforms="darwin-arm64 darwin-x64 linux-x64 linux-arm64"
_prune_physical() { (cd -P -- "$1" 2>/dev/null && pwd); }   # the directory with every symlink resolved
_prune_human() { awk -v k="$1" 'BEGIN { if (k >= 1048576) printf "%.1f GB", k / 1048576; else printf "%.0f MB", k / 1024 }'; }
_prune_sessions_safe() {   # DIR SESSIONS: every file in DIR/.pi/sessions is byte-identical under SESSIONS
  local dir="$1" sessions="$2" f rel ok=0
  [[ -d "$dir/.pi/sessions" && ! -L "$dir/.pi/sessions" ]] || return 0
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    rel="${f#"$dir/.pi/sessions/"}"
    if ! cmp -s -- "$f" "$sessions/$rel"; then echo "  $f is not in $sessions (byte-identical)"; ok=1; fi
  done <<EOF
$(find "$dir/.pi/sessions" -type f 2>/dev/null)
EOF
  return $ok
}
prune_versions() {
  local root="$1" prefix="$2" platform="$3" keep="$4" dry="$5" sessions="$6" previous="${7:-}" also_keep="${8:-}"
  local root_real cur_real cur e base rest ver p other rows="" maj min pat rank pre kept=0 kb freed=0 n=0 verb="removed"
  [[ "$dry" == 1 ]] && verb="would remove"
  case "$keep" in ''|*[!0-9]*|0*) echo "prune: KERNAL_KEEP_VERSIONS must be a whole number, 1 or more (got '$keep'); nothing removed"; return 1 ;; esac
  root_real="$(_prune_physical "$root")"
  [[ -n "$root_real" ]] || { echo "prune: cannot resolve $root; nothing removed"; return 1; }
  [[ -L "$root/current" ]] || { echo "prune: $root/current is not a symlink; nothing removed"; return 1; }
  cur_real="$(_prune_physical "$root/current")"
  cur="${cur_real#"$root_real"/}"
  if [[ -z "$cur_real" || "$cur_real" != "$root_real/"* || "$cur" == */* ]]; then
    echo "prune: $root/current does not resolve to a bundle inside $root_real (${cur_real:-dangling}); nothing removed"; return 1
  fi
  ver="${cur#"$prefix"-}"; ver="${ver%-"$platform"}"
  if [[ "$cur" != "$prefix-$ver-$platform" ]] || ! [[ "$ver" =~ $_prune_semver_re ]]; then
    echo "prune: current points to $cur, not a $prefix-<version>-$platform bundle; nothing removed"; return 1
  fi
  # previous / also_keep only matter when they are one of this root's bundles; anything else is ignored
  previous="${previous#"$root_real"/}"; also_keep="${also_keep#"$root_real"/}"
  for e in "$root_real/$prefix"-*; do
    [[ -e "$e" || -L "$e" ]] || continue    # the glob matched nothing
    base="${e##*/}"
    if [[ -L "$e" ]]; then echo "prune: $e is a symlink, not a bundle; nothing removed"; return 1; fi
    if [[ ! -d "$e" ]]; then echo "prune: $e is not a directory; nothing removed"; return 1; fi
    rest="${base#"$prefix"-}"; other=""
    for p in $_prune_platforms; do
      [[ "$rest" == *"-$p" ]] || continue
      ver="${rest%-"$p"}"
      [[ "$ver" =~ $_prune_semver_re ]] && other="$p"
    done
    if [[ -z "$other" ]]; then echo "prune: $e is not named $prefix-<version>-<platform>; nothing removed"; return 1; fi
    [[ "$other" == "$platform" ]] || continue    # another platform's bundle: not ours to judge
    ver="${rest%-"$platform"}"
    if [[ "$(_prune_physical "$e")" != "$root_real/$base" ]]; then echo "prune: $e resolves outside $root_real; nothing removed"; return 1; fi
    [[ "$ver" =~ $_prune_semver_re ]] || { echo "prune: cannot parse the version of $e; nothing removed"; return 1; }
    maj="${BASH_REMATCH[1]}"; min="${BASH_REMATCH[2]}"; pat="${BASH_REMATCH[3]}"; pre="${BASH_REMATCH[4]}"
    if [[ -z "$pre" ]]; then rank=1; pre="-"; else rank=0; fi
    rows="$rows$maj $min $pat $rank $pre $base
"
  done
  # Highest version first. Every field is space-free (enforced by the pattern), so sort is exact.
  rows="$(printf '%s' "$rows" | sort -t ' ' -k1,1nr -k2,2nr -k3,3nr -k4,4nr -k5,5r -k6,6r)"
  kept=1                                                   # current
  if [[ -n "$previous" && "$previous" != "$cur" && -d "$root_real/$previous" && "$keep" -ge 2 ]]; then
    case "
$rows
" in *" $previous
"*) kept=2 ;; *) previous="" ;; esac
  else
    previous=""
  fi
  local keep_list="$cur${previous:+, $previous}" remove_list=""
  while IFS=' ' read -r maj min pat rank pre base; do
    [[ -n "${base:-}" ]] || continue
    [[ "$base" == "$cur" || "$base" == "$previous" ]] && continue
    if [[ -n "$also_keep" && "$base" == "$also_keep" ]]; then keep_list="$keep_list, $base (running)"; continue; fi
    if [[ "$kept" -lt "$keep" ]]; then kept=$((kept + 1)); keep_list="$keep_list, $base"; continue; fi
    remove_list="$remove_list$base
"
  done <<EOF
$rows
EOF
  while IFS= read -r base; do
    [[ -n "$base" ]] || continue
    [[ "$base" != "$cur" && "$base" != "$previous" && "$base" != "$also_keep" ]] || continue   # belt and braces
    e="$root_real/$base"
    if ! _prune_sessions_safe "$e" "$sessions"; then echo "prune: kept $e: it holds sessions not copied to state (above)"; continue; fi
    kb="$(du -sk "$e" 2>/dev/null | awk '{print $1}')"; kb="${kb:-0}"
    if [[ "$dry" != 1 ]]; then
      rm -rf -- "$e"
      if [[ -e "$e" ]]; then echo "prune: could not fully remove $e; stopping"; return 1; fi
    fi
    echo "prune: $verb $e ($(_prune_human "$kb"))"
    freed=$((freed + kb)); n=$((n + 1))
  done <<EOF
$remove_list
EOF
  if [[ "$n" -eq 0 ]]; then echo "prune: nothing to remove in $root_real (keeping $keep_list)"
  else echo "prune: $verb $n old version(s), $(_prune_human "$freed"); kept $keep_list"; fi
  return 0
}
# --- prune: end -------------------------------------------------------------------------------------
# Resolve symlinks (install.sh links ~/.local/bin/kernal here) so ROOT is the real bundle directory.
SRC="${BASH_SOURCE[0]}"
while [[ -L "$SRC" ]]; do DIR="$(cd -P "$(dirname "$SRC")" && pwd)"; SRC="$(readlink "$SRC")"; [[ "$SRC" != /* ]] && SRC="$DIR/$SRC"; done
ROOT="$(cd -P "$(dirname "$SRC")/.." && pwd)"
# Secrets: ~/localllm/.env in a source checkout, ./.env in a release bundle (/setup writes it).
found_env=0
if [[ -f "$ROOT/../.env" ]]; then set -a; source "$ROOT/../.env"; set +a; found_env=1; fi
if [[ -f "$ROOT/.env" ]]; then set -a; source "$ROOT/.env"; set +a; found_env=1; fi
[[ $found_env == 1 ]] || echo "kernal: no .env yet — run /setup inside the agent to configure your connections" >&2
export PI_CODING_AGENT_DIR="$ROOT/.pi"
# A release bundle pins pi's version: it changes only with Kernal itself (`kernal update`), so pi's own
# "New version available. Run pi update" notice is wrong advice here. A source checkout keeps it, as a
# signal to whoever maintains Kernal that there is a newer pi to adopt.
[[ -f "$ROOT/VERSION" ]] && export PI_SKIP_VERSION_CHECK=1
# pi-lsp (and its siblings) look for their own agent dir under $PI_AGENT_DIR, defaulting to
# ~/.pi/agent, which kernal does not use. Point it at the bundle so .pi/agent/lsp.json is read as the
# user-owned (auto-trusted) config: a project-local .pi/lsp.json needs a trust prompt and is
# rejected outright in -p mode. One level below .pi/ so that running kernal inside this folder does
# not also find it by walking up for a project-local .pi/lsp.json.
export PI_AGENT_DIR="$ROOT/.pi/agent"

# Release bundles ship pi's official standalone binary in ./pi; a source checkout uses the npm one.
if [[ -x "$ROOT/pi/pi" ]]; then PI="$ROOT/pi/pi"; else PI="$ROOT/node_modules/.bin/pi"; fi

# Agent Engine memory on a laptop (#349, .pi/extensions/outfitter-agentengine/laptop.ts): while it is
# on, pi-memory's prompt injection and exit summary are off. That has to happen here, before pi
# starts, because pi-memory reads its directory when it is imported. On means `kernal.memory` is
# "tool" or "auto" in settings.json, or unset with a Dongle (OUTFITTER_API and OUTFITTER_TOKEN)
# configured; the extension reads the same setting the same way. Never inside a Drive (agentd decides
# there). The real directory goes on in KERNAL_PI_MEMORY_SOURCE for `/memory import`.
# Signed in, `memory.mode` is a central setting (#437): central-config writes its resolution, with
# each value's source, to effective[.<profile>].json in the config cache (non-secret), and the
# account's or this machine's value (sources user, profile, device, local) wins over kernal.memory,
# which wins over the fleet's, exactly as outfitter-agentengine/laptop.ts chosenMode decides.
# effective_file: prints the effective[.<profile>].json central-config wrote (#437), or nothing. Only
# while signed in (accounts.json exists), and only when the file is for the account signed in now on
# this OUTFITTER_API (its `api` and `account`): after a sign-out and a sign-in to another account the
# previous account's file is still there until pi resolves again, which is after this script decided.
# The directory is central-config's configCacheDir, with the same KERNAL_*/MGM_* fallback (kenv).
effective_file() {
  local auth="${KERNAL_AUTH_DIR:-$HOME/.kernal/auth}" home cache f api eapi eacct
  [[ -f "$auth/accounts.json" ]] || return 0
  home="$(kenv HOME_DIR || printf '%s' "$HOME/.kernal")"
  cache="$(kenv CONFIG_CACHE_DIR || printf '%s/config-cache' "$home")"
  f="$cache/effective${KERNAL_PROFILE:+.$KERNAL_PROFILE}.json"
  [[ -f "$f" ]] || return 0
  api="${OUTFITTER_API:-https://link.kernal.one}"
  while [[ "$api" == */ ]]; do api="${api%/}"; done
  if command -v node >/dev/null 2>&1; then
    # outfitter-session.ts's pickEntry without an email: the API's default account, or its only one.
    node -e '
      const fs = require("fs"); const [index, effective, api] = process.argv.slice(1);
      const read = (f) => { try { return JSON.parse(fs.readFileSync(f, "utf8")); } catch { return undefined; } };
      const i = read(index) || {}, e = read(effective) || {};
      const here = (Array.isArray(i.accounts) ? i.accounts : []).filter((a) => a && a.api === api && typeof a.email === "string");
      const def = i.defaults && i.defaults[api];
      const cur = here.find((a) => a.email === def) || (here.length === 1 ? here[0] : undefined);
      process.exit(cur && e.api === api && e.account === cur.email ? 0 : 1);' "$auth/accounts.json" "$f" "$api" 2>/dev/null || return 0
  else
    # Without node: the file's top-level `api` and `account` lines, and that account and API in the
    # index (one field per line, as JSON.stringify(…, null, 2) writes both files).
    eapi="$(sed -nE 's/^  "api": "([^"]*)".*/\1/p' "$f" 2>/dev/null | head -1)"
    eacct="$(sed -nE 's/^  "account": "([^"]*)".*/\1/p' "$f" 2>/dev/null | head -1)"
    [[ -n "$eacct" && "$eapi" == "$api" ]] || return 0
    grep -qF "\"email\": \"$eacct\"" "$auth/accounts.json" 2>/dev/null || return 0
    grep -qF "\"api\": \"$api\"" "$auth/accounts.json" 2>/dev/null || return 0
  fi
  printf '%s' "$f"
}

pi_memory_env() {
  [[ -z "${OUTFITTER_SESSION_ID:-}" && -z "${OUTFITTER_ADMIN_SOCKET:-}" ]] || return 0
  # A Dongle, or a stored login (`kernal login`, central-auth.md §2.7: its index exists only while one does).
  local effective
  effective="$(effective_file)"
  [[ -n "${OUTFITTER_API:-}" && -n "${OUTFITTER_TOKEN:-}" ]] || [[ -f "${KERNAL_AUTH_DIR:-$HOME/.kernal/auth}/accounts.json" ]] || return 0
  local mode empty parent emode esrc legacy settings="$PI_CODING_AGENT_DIR/settings.json"
  # Exactly kernal.memory, the way the extension reads it (unparseable JSON reads as unset there too).
  # Without node, the first `"memory": "off|tool|auto"` line, which is where /memory writes it, and
  # the effective file's `"memory.mode"` lines (one under values, one under sources).
  if command -v node >/dev/null 2>&1; then
    mode="$(node -e '
      const fs = require("fs"); const [settingsFile, effectiveFile] = process.argv.slice(1);
      const read = (f) => { try { return JSON.parse(fs.readFileSync(f, "utf8")); } catch { return undefined; } };
      const ok = (m) => (["off", "tool", "auto"].includes(m) ? m : undefined);
      const s = read(settingsFile); const legacy = ok(s && s.kernal && s.kernal.memory);
      const e = effectiveFile ? read(effectiveFile) : undefined;
      const v = e && e.version === 1 && e.values ? ok(e.values["memory.mode"]) : undefined;
      const src = e && e.sources ? e.sources["memory.mode"] : undefined;
      const fleet = e && e.fleet ? ok(e.fleet["memory.mode"]) : undefined;
      const m = v && ["local", "user", "profile", "device"].includes(src) ? v : legacy || fleet;
      if (m) process.stdout.write(m);' "$settings" "$effective" 2>/dev/null || true)"
  else
    local efleet=""
    legacy="$(sed -nE 's/^[[:space:]]*"memory":[[:space:]]*"(off|tool|auto)".*/\1/p' "$settings" 2>/dev/null | head -1)"
    if [[ -n "$effective" ]]; then
      emode="$(sed -nE '/"values"/,/^  }/ s/^[[:space:]]*"memory\.mode":[[:space:]]*"(off|tool|auto)".*/\1/p' "$effective" 2>/dev/null | head -1)"
      esrc="$(sed -nE '/"sources"/,/^  }/ s/^[[:space:]]*"memory\.mode":[[:space:]]*"([a-z]+)".*/\1/p' "$effective" 2>/dev/null | head -1)"
      efleet="$(sed -nE '/"fleet"/,/^  }/ s/^[[:space:]]*"memory\.mode":[[:space:]]*"(off|tool|auto)".*/\1/p' "$effective" 2>/dev/null | head -1)"
    fi
    case "${esrc:-}" in
      local|user|profile|device) mode="${emode:-$legacy}" ;;
      *) mode="${legacy:-$efleet}" ;;
    esac
  fi
  [[ "${mode:-auto}" != off ]] || return 0
  # A fresh empty directory per start (pi-memory writes compaction handoffs into it, which must not
  # reach another session), under one private parent whose day-old leftovers are cleared here.
  parent="${TMPDIR:-/tmp}"; parent="${parent%/}/kernal-no-pi-memory"
  mkdir -p -m 700 "$parent" 2>/dev/null || return 0
  [[ -d "$parent" && ! -L "$parent" && -O "$parent" ]] || return 0
  find "$parent" -mindepth 1 -maxdepth 1 -type d -mtime +1 -exec rm -rf {} + 2>/dev/null || true
  empty="$(mktemp -d "$parent/XXXXXX" 2>/dev/null)" || return 0
  export KERNAL_PI_MEMORY_SOURCE="${KERNAL_PI_MEMORY_SOURCE:-${PI_MEMORY_DIR:-$HOME/.pi/agent/memory}}"
  export PI_MEMORY_DIR="$empty" PI_MEMORY_EXIT_SUMMARY=0 KERNAL_PI_MEMORY_OFF=1
}

# Maintenance:
#   kernal version                     what is installed
#   kernal update [x.y.z]              upgrade the kernal bundle itself (release bundles only)
#   kernal update --extensions         update the installed pi packages (pi's own updater)
#   kernal update --extension <src>    update one package
#   kernal update --models             refresh pi's model catalogs
#   kernal prune [--dry-run]           remove old installed versions (keeps KERNAL_KEEP_VERSIONS, default 2)
#   kernal prune --legacy [--yes]      list (and with --yes delete) the pre-rename ~/.mgm bundles
# prune_legacy LEGACY PLATFORM SESSIONS NEW_ROOT YES: `kernal prune --legacy [--yes]`.
# The pre-rename ~/.mgm: the 0.2.0 migration copied its state to ~/.kernal/state and left it in place
# with a MOVED note. What is worth reclaiming there is its release bundles (mgm-<semver>-<platform>,
# ~450 MB each); state/, MOVED, current and everything else stay. The bundles are not only code:
# pre-0.1.12 ones hold real session files and every one holds an old .env, so this never runs on its
# own (install.sh does not call it) and deletes only with --yes. Without --yes it lists exactly
# what would go. With or without it, it refuses, removing nothing, unless:
#   - LEGACY is a real directory carrying MOVED (the migration ran), and its `current` (if any) does
#     not resolve to anything inside LEGACY;
#   - every mgm-* entry is a real directory named exactly mgm-<semver>-<platform> (another
#     platform's bundles are left alone);
#   - every session file under LEGACY/**/.pi/sessions and LEGACY/state/sessions exists byte-identical
#     in SESSIONS (~/.kernal/state/sessions);
#   - if a bundle to be removed has a .env, the new install has one too.
prune_legacy() {
  local legacy="$1" platform="$2" sessions="$3" new_root="$4" yes="$5"
  local legacy_real cur_real e base rest ver p other f rel sz bad=0 kb total=0 n=0 remove="" what count kept=""
  if [[ ! -d "$legacy" || -L "$legacy" ]]; then echo "prune --legacy: no pre-rename install at $legacy; nothing to do"; return 0; fi
  legacy_real="$(_prune_physical "$legacy")"
  [[ -n "$legacy_real" ]] || { echo "prune --legacy: cannot resolve $legacy; nothing removed"; return 1; }
  [[ -f "$legacy_real/MOVED" ]] || { echo "prune --legacy: $legacy has no MOVED note, so it was never migrated; run 'kernal update' first. Nothing removed."; return 1; }
  [[ -d "$sessions" ]] || { echo "prune --legacy: $sessions does not exist, so nothing can be verified; nothing removed"; return 1; }
  if [[ -e "$legacy_real/current" || -L "$legacy_real/current" ]]; then
    cur_real="$(_prune_physical "$legacy_real/current")"
    if [[ -z "$cur_real" || "$cur_real" == "$legacy_real/"* ]]; then
      echo "prune --legacy: $legacy/current resolves to ${cur_real:-nothing}, not to the new install; nothing removed"; return 1
    fi
  fi
  for e in "$legacy_real"/mgm-*; do
    [[ -e "$e" || -L "$e" ]] || continue    # the glob matched nothing
    base="${e##*/}"
    if [[ -L "$e" || ! -d "$e" ]]; then echo "prune --legacy: $e is not a bundle directory; nothing removed"; return 1; fi
    rest="${base#mgm-}"; other=""
    for p in $_prune_platforms; do
      [[ "$rest" == *"-$p" ]] || continue
      ver="${rest%-"$p"}"
      [[ "$ver" =~ $_prune_semver_re ]] && other="$p"
    done
    if [[ -z "$other" ]]; then echo "prune --legacy: $e is not named mgm-<version>-<platform>; nothing removed"; return 1; fi
    [[ "$other" == "$platform" ]] || continue
    if [[ "$(_prune_physical "$e")" != "$legacy_real/$base" ]]; then echo "prune --legacy: $e resolves outside $legacy_real; nothing removed"; return 1; fi
    remove="$remove$base
"
  done
  # Every session file, in every bundle (find does not follow the later bundles' links to state/)
  # and in state/sessions, must be in the new state byte for byte.
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    case "$f" in
      "$legacy_real/state/sessions/"*) rel="${f#"$legacy_real/state/sessions/"}" ;;
      *) rel="${f#*/.pi/sessions/}" ;;
    esac
    cmp -s -- "$f" "$sessions/$rel" && continue
    bad=$((bad + 1))
    if [[ ! -f "$sessions/$rel" ]]; then echo "  missing from $sessions: $f"
    else
      sz="$(wc -c < "$f" | tr -d ' ')"
      if head -c "$sz" "$sessions/$rel" | cmp -s - "$f"; then echo "  differs: $f (the copy at $sessions/$rel is a longer continuation of it)"
      else echo "  differs: $f (from $sessions/$rel)"; fi
    fi
  done <<EOF
$(find "$legacy_real" -path '*/.pi/sessions/*' -type f 2>/dev/null; if [[ -d "$legacy_real/state/sessions" ]]; then find "$legacy_real/state/sessions" -type f 2>/dev/null; fi)
EOF
  if [[ "$bad" -gt 0 ]]; then
    echo "prune --legacy: $bad session file(s) above are not byte-identical in $sessions; nothing removed."
    echo "  Keeping them loses nothing. Copy or remove those files yourself, then run this again."
    return 1
  fi
  if [[ -z "$remove" ]]; then echo "prune --legacy: no mgm-<version>-$platform bundles in $legacy_real; nothing to do"; return 0; fi
  while IFS= read -r base; do
    [[ -n "$base" ]] || continue
    if [[ -f "$legacy_real/$base/.env" && ! -f "$new_root/current/.env" ]]; then
      echo "prune --legacy: $legacy_real/$base/.env holds keys and $new_root/current/.env does not exist; nothing removed"; return 1
    fi
  done <<EOF
$remove
EOF
  if [[ "$yes" == 1 ]]; then echo "prune --legacy: deleting from $legacy_real:"; else echo "prune --legacy: would delete from $legacy_real (dry run):"; fi
  while IFS= read -r base; do
    [[ -n "$base" ]] || continue
    e="$legacy_real/$base"
    kb="$(du -sk "$e" 2>/dev/null | awk '{print $1}')"; kb="${kb:-0}"
    what=""
    for f in .env .pi/auth.json .pi/trust.json .pi/settings.json; do
      if [[ -f "$e/$f" && ! -L "$e/$f" ]]; then what="$what, $f"; fi
    done
    if [[ -d "$e/.pi/sessions" && ! -L "$e/.pi/sessions" ]]; then
      count="$(find "$e/.pi/sessions" -type f 2>/dev/null | wc -l | tr -d ' ')"
      [[ "$count" == 0 ]] || what="$what, $count session file(s), verified identical in $sessions"
    fi
    echo "  $e  $(_prune_human "$kb")${what:+  (includes ${what#, })}"
    if [[ "$yes" == 1 ]]; then
      rm -rf -- "$e"
      if [[ -e "$e" ]]; then echo "prune --legacy: could not fully remove $e; stopping"; return 1; fi
    fi
    total=$((total + kb)); n=$((n + 1))
  done <<EOF
$remove
EOF
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    case "
$remove" in *"
$f
"*) continue ;; esac
    kept="$kept $f"
  done <<EOF
$(ls -A "$legacy_real")
EOF
  echo "  left in place:${kept:- (nothing else)}"
  if [[ "$yes" == 1 ]]; then echo "prune --legacy: deleted $n bundle(s), freed $(_prune_human "$total")"
  else echo "prune --legacy: $n bundle(s), $(_prune_human "$total"). Nothing was deleted; to delete exactly these: kernal prune --legacy --yes"; fi
  return 0
}
REPO="cognitio-org/mgm-pi"

# kernal's own bin directory (where /github setup installs the GitHub CLI) goes on PATH, LAST, so a
# gh the user installed themselves still wins and nothing here shadows a system tool.
KERNAL_OWN_BIN="${KERNAL_HOME:-$HOME/.kernal}/bin"
[[ -f "$ROOT/VERSION" ]] || KERNAL_OWN_BIN="$ROOT/.pi/bin"     # a source checkout keeps it out of $HOME
[[ -d "$KERNAL_OWN_BIN" ]] && export PATH="$PATH:$KERNAL_OWN_BIN"

# Central settings (#397, outfitter/docs/specs/central-auth.md §2.6): `--profile <name>` (or
# `--profile=<name>`) anywhere on the command line picks this process's settings profile. It is
# consumed here and passed on as KERNAL_PROFILE, which pi never sees as a flag.
_args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile)
      [[ -n "${2:-}" && "${2:-}" != -* ]] || { echo "kernal: --profile needs a profile name" >&2; exit 2; }
      export KERNAL_PROFILE="$2"; shift 2 ;;
    --profile=*) export KERNAL_PROFILE="${1#--profile=}"; shift ;;
    *) _args+=("$1"); shift ;;
  esac
done
set -- ${_args[@]+"${_args[@]}"}

case "${1:-}" in
  login|logout|whoami)
    # Sign-in to Outfitter (#391, central-auth.md §2.5): before pi starts, with node.
    exec node "$ROOT/.pi/extensions/kernal-login/cli.ts" "$@" ;;
  github)
    # The same setup /github runs inside the agent, from a plain terminal.
    if command -v gh >/dev/null 2>&1; then
      echo "gh: $(command -v gh) ($(gh --version | head -1))"
      gh auth status --hostname github.com 2>&1 | sed 's/^/  /'
      echo
      echo "If you are not signed in:"
    else
      echo "The GitHub CLI is not installed. Start kernal and run /github setup, which installs it into $KERNAL_OWN_BIN, or install it yourself."
      echo
      echo "Then sign in:"
    fi
    echo "  gh auth login --web --git-protocol https --hostname github.com --scopes workflow"
    echo "  gh auth setup-git --hostname github.com     # so git push over https uses that login"
    exit 0 ;;
  version|--version) [[ -f "$ROOT/VERSION" ]] && cat "$ROOT/VERSION" || echo "kernal (source checkout at $ROOT)"; exit 0 ;;
  prune)
    # Removes old release bundles now, exactly as every upgrade does afterwards (keeps
    # KERNAL_KEEP_VERSIONS, default 2: current and the newest other; never state/ or .env). It acts
    # without a dry run by default because that is what `kernal update` does unprompted and what it
    # removes is re-downloadable release code; --dry-run shows it first. --legacy is different: it
    # is about the pre-rename ~/.mgm, whose bundles hold old sessions and keys, so it only ever lists
    # unless given --yes (see prune_legacy above).
    shift; dry=0; legacy=0; yes=0
    while [[ $# -gt 0 ]]; do
      case "$1" in
        -n|--dry-run) dry=1 ;;
        --legacy) legacy=1 ;;
        -y|--yes) yes=1 ;;
        *) echo "Usage: kernal prune [--dry-run]   |   kernal prune --legacy [--yes]" >&2; exit 2 ;;
      esac
      shift
    done
    [[ -f "$ROOT/VERSION" ]] || { echo "kernal: $ROOT is a source checkout; there are no installed versions to prune" >&2; exit 1; }
    home_dir="$(cd -P "$ROOT/.." && pwd)"
    state="$(kenv STATE || true)"; state="${state:-$home_dir/state}"
    os=$(uname -s | tr '[:upper:]' '[:lower:]'); arch=$(uname -m | sed 's/x86_64/x64/; s/aarch64/arm64/')
    if [[ "$legacy" == 1 ]]; then
      prune_legacy "$HOME/.mgm" "$os-$arch" "$state/sessions" "$home_dir" "$yes" || exit 1
      exit 0
    fi
    [[ "$yes" == 0 ]] || { echo "kernal: --yes is only for --legacy; 'kernal prune' removes old versions without asking (see --dry-run)" >&2; exit 2; }
    keep="$(kenv KEEP_VERSIONS || true)"
    prune_versions "$home_dir" kernal "$os-$arch" "${keep:-2}" "$dry" "$state/sessions" "" "$ROOT" || exit 1
    [[ "$dry" == 0 ]] || echo "(dry run: nothing was removed)"
    exit 0 ;;
  update|--update)
    # Package/catalog updates are pi's job; only the bundle itself is ours.
    case "${2:-}" in
      --extensions|--extension)
        # In a bundle the packages are pinned to what the release was tested with, and pi's updater
        # skips pinned packages, so this would silently do nothing. Say what actually updates them.
        if [[ -f "$ROOT/VERSION" ]]; then
          echo "kernal: in an installed release the packages are pinned to the versions it was tested with;"
          echo "        they update with kernal itself. Run: kernal update"
          exit 0
        fi
        shift; exec "$PI" update "$@" -a ;;
      --models|--force)
        shift; exec "$PI" update "$@" -a ;;
      --all|--self)
        echo "kernal: use 'kernal update' for the agent bundle and 'kernal update --extensions' for the packages" >&2; exit 2 ;;
    esac
    [[ -f "$ROOT/VERSION" ]] || { echo "kernal: $ROOT is a source checkout — update it with git pull" >&2; exit 1; }
    tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
    if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
      gh release download ${2:+"v$2"} --repo "$REPO" --pattern install.sh --dir "$tmp" --clobber
    else
      curl -fsSL ${GH_TOKEN:+-H "Authorization: Bearer $GH_TOKEN"} -o "$tmp/install.sh" "https://github.com/$REPO/releases/${2:+download/v$2}${2:-latest/download}/install.sh" \
        || { echo "kernal: could not download the installer — log in with 'gh auth login' or set GH_TOKEN" >&2; exit 1; }
    fi
    # The downloaded install.sh copies chrome/extension and chrome/host onto stable
    # paths ($KERNAL_HOME/chrome, not this versioned bundle) and refreshes the
    # native-messaging manifest. An unpacked extension keeps the old files until reload.
    KERNAL_HOME="$(cd -P "$ROOT/.." && pwd)" KERNAL_VERSION="${2:-}" bash "$tmp/install.sh"; exit $? ;;
  --teleport)
    # The pull runs inside pi, not before it (#426): a bundle ships pi as a compiled binary, so a
    # node-run script can't import pi's SessionManager. pi runs its first message as a slash command
    # once the session is up, so pi starts on "/teleport pull <id>": the teleport extension's own pull
    # (store lookup, repo/branch checks, import, then a switch to that session). With a UI, errors
    # show there; without one (-p, --mode json) they go to stderr and pi exits 1.
    id="${2:-}"
    if [[ -z "$id" || "$id" == -* ]]; then echo "Usage: kernal --teleport <session-id> [--force] [pi args...]" >&2; exit 1; fi
    # The id travels inside the slash command, which the extension splits on whitespace.
    if [[ ! "$id" =~ ^[A-Za-z0-9._:-]+$ ]]; then echo "kernal --teleport: \"$id\" is not a session id" >&2; exit 1; fi
    shift 2
    # --force (only meaningful for KERNAL_TELEPORT_STORE=outfitter: skip waiting for an active cloud
    # run to stop) goes to the pull, not to pi. pi puts @file text in front of the first message,
    # which would stop it being a command, so @file arguments are refused here. bash 3.2 (macOS
    # default) treats an empty array as unbound under set -u, hence ${arr[@]+"${arr[@]}"} below.
    pull="/teleport pull $id"
    rest=()
    for a in "$@"; do
      if [[ "$a" == "--force" ]]; then pull="$pull --force"
      elif [[ "$a" == @* ]]; then echo "kernal --teleport: @file arguments can't be combined with --teleport; attach them once the session is open" >&2; exit 1
      else rest+=("$a"); fi
    done
    if [[ -x "$ROOT/pi/pi" ]]; then PI="$ROOT/pi/pi"; else PI="$ROOT/node_modules/.bin/pi"; fi
    pi_memory_env
    exec "$PI" -a "$pull" ${rest[@]+"${rest[@]}"} ;;
esac

# Make sure the local model is resident so pi does not stall on LM Studio's just-in-time reload.
# The context length LM Studio serves cannot be forced from the CLI for MLX models (the flag is
# ignored, Qwen 3.6 loads at 183k); pi budgets against the window the provider declares
# (LMSTUDIO_CONTEXT, default 32768), which is deliberately the smaller of the two.
# Only worth doing when the saved default backend is lmstudio (the router is the default now, and
# loading a 20 GB model would otherwise delay every start); KERNAL_PRELOAD_LMS=1 forces it.
LMS="${LMS:-$HOME/.lmstudio/bin/lms}"; MODEL="${LMSTUDIO_MODEL:-qwen/qwen3.6-35b-a3b}"
default_provider="$(sed -n 's/^ *"defaultProvider": *"\([^"]*\)".*/\1/p' "$ROOT/.pi/settings.json" 2>/dev/null | head -1)"
# Signed in, the account's (or this machine's) model.provider decides the start-up backend (#437;
# kernal-config switches the new session to it), so it decides the preload too.
_eff="$(effective_file)"
if [[ -n "$_eff" ]]; then
  _p="$(sed -nE '/"values"/,/^  }/ s/^[[:space:]]*"model\.provider":[[:space:]]*"(litellm|lmstudio|openrouter)".*/\1/p' "$_eff" 2>/dev/null | head -1)"
  _s="$(sed -nE '/"sources"/,/^  }/ s/^[[:space:]]*"model\.provider":[[:space:]]*"([a-z]+)".*/\1/p' "$_eff" 2>/dev/null | head -1)"
  case "$_s" in local|user|profile|device) [[ -z "$_p" ]] || default_provider="$_p" ;; esac
fi
skip_lms="$(kenv SKIP_LMS || true)"; preload_lms="$(kenv PRELOAD_LMS || true)"
if [[ "$skip_lms" != 1 && -x "$LMS" && ( "$default_provider" == lmstudio || "$preload_lms" == 1 ) ]]; then
  if ! "$LMS" ps --json 2>/dev/null | grep -q "\"identifier\":\"$MODEL\""; then
    echo "kernal: loading $MODEL in LM Studio…" >&2
    timeout 180 "$LMS" load "$MODEL" --context-length "${LMSTUDIO_CONTEXT:-32768}" --ttl 86400 -y >/dev/null 2>&1 || echo "kernal: LM Studio load failed or timed out; continuing" >&2
  fi
fi
pi_memory_env
exec "$PI" -a "$@"
