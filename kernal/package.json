{
  "name": "kernal",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "kernal coding agent (built on pi) with a /connect command for LM Studio (MLX), the LiteLLM router, or OpenRouter",
  "scripts": {
    "start": "./bin/kernal",
    "models": "./bin/kernal --list-models",
    "test": "node --test-global-setup=./tests/home-guard.mjs --import ./tests/resolve-pi.mjs --test 'tests/*.test.ts'",
    "test:e2e": "KERNAL_E2E=1 node --import ./tests/resolve-pi.mjs --test tests/e2e.test.ts",
    "test:coverage": "node --test-global-setup=./tests/home-guard.mjs --import ./tests/resolve-pi.mjs --test --experimental-test-coverage --test-coverage-include='.pi/extensions/**/*.ts' 'tests/*.test.ts'",
    "test:live": "KERNAL_LIVE=1 node --test-global-setup=./tests/home-guard.mjs --import ./tests/resolve-pi.mjs --test tests/live.test.ts",
    "build:index": "bash scripts/prebundle.sh .pi/npm/node_modules"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1"
  }
}
