{
  "defaultProvider": "litellm",
  "defaultModel": "gpt-5.4-nano",
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:pi-web-access",
    "npm:pi-subagents",
    "npm:pi-powerline-footer",
    "npm:pi-memory",
    "npm:pi-lsp",
    "npm:@codexstar/pi-listen"
  ],
  "lastChangelogVersion": "0.86.1",
  "theme": "dark",
  "powerline": {
    "preset": "default",
    "welcome": false
  },
  "compaction": {
    "reserveTokens": 8192,
    "keepRecentTokens": 6000
  },
  "modelThinkingLevels": {
    "lmstudio/qwen/qwen3.6-35b-a3b": "off",
    "litellm/local-qwen-mlx": "off"
  },
  "subagents": {
    "defaultModel": "litellm/gemini-3.8-flash",
    "agentOverrides": {
      "worker": {
        "model": "litellm/claude-sonnet-5"
      },
      "reviewer": {
        "model": "litellm/claude-sonnet-5"
      },
      "oracle": {
        "model": "litellm/claude-opus-5-high"
      }
    }
  }
}
