# Copy to .env for `agentengine dev up`. Never commit .env.
# `agentengine deploy` requires every populated key here to exist as an Agent Engine secret.
MONGODB_URI=
# LiteLLM virtual key for router.kernal.one (llm.py).
LLM_API_KEY=
# Outfitter's link origin, and an A2A key scoped to the a2a-coder tape (keys expire in 90 days).
OUTFITTER_A2A_URL=https://link.kernal.one
OUTFITTER_A2A_KEY=
