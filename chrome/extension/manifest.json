{
  "manifest_version": 3,
  "name": "Kernal",
  "version": "0.1.0",
  "description": "Connects this Chrome to a Kernal Floppy.",
  "key": "",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "externally_connectable": {
    "matches": [
      "https://app.kernal.one/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}
