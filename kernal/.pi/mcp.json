{
  "mcpServers": {
    "litellm": {
      "url": "https://router.kernal.one/mcp/",
      "headers": {
        "x-litellm-api-key": "![ -n \"$KERNAL_ROUTER_KEY\" ] || exit 1; printf 'Bearer %s' \"$KERNAL_ROUTER_KEY\"",
        "x-mcp-servers": "ce_knowledge_base,headroom"
      }
    },
    "sentry": {
      "url": "https://router.kernal.one/sentry/mcp",
      "auth": "oauth",
      "headers": {
        "x-litellm-api-key": "Bearer ${KERNAL_ROUTER_KEY}"
      },
      "oauth": {
        "clientName": "kernal"
      }
    },
    "gcloud": {
      "url": "https://router.kernal.one/gcloud/mcp",
      "auth": "oauth",
      "lifecycle": "lazy",
      "disabled": true,
      "approveTools": true,
      "headers": {
        "x-litellm-api-key": "Bearer ${KERNAL_ROUTER_KEY}"
      },
      "oauth": {
        "clientName": "kernal"
      }
    },
    "google_admin": {
      "url": "https://gcs-admin-mcp-ucpy26yrfa-uc.a.run.app/mcp",
      "auth": "oauth",
      "oauth": {
        "clientName": "kernal agent"
      }
    },
    "augment_admin": {
      "url": "https://l.augment-code.support/mcp",
      "auth": "oauth",
      "oauth": {
        "clientName": "kernal agent"
      },
      "directTools": false
    }
  }
}
