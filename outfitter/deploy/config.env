# Non-secret deploy settings, sourced by env.sh. Checked in so every deploy -- from GitHub Actions
# or a laptop -- sets the same environment: `gcloud run deploy --set-env-vars` replaces a service's
# whole environment, so a value that only lives in one person's shell gets dropped by the next
# deploy from anywhere else. Secrets stay in Secret Manager (README.md "Secret Manager").
#
# Each line keeps an already-exported value, so `OUTFITTER_OPERATORS=... ./release.sh` still
# overrides for one run. Change a value here (and merge) to change it for good.

# The laptop LM Studio tunnel (tunnel.sh in the repo root); the E2.8 preflight probes it. Access to
# it is gated by LOCAL_TUNNEL_TOKEN (a secret), not by this name being private.
TUNNEL_DOMAIN_LMSTUDIO="${TUNNEL_DOMAIN_LMSTUDIO:-mgm-lmstudio.ngrok.app}"
LITELLM_BASE_URL="${LITELLM_BASE_URL:-https://litellm.augment-code.support/v1}"
PROVIDER_POLL_MS="${PROVIDER_POLL_MS:-300000}"
IDLE_STOP_SECONDS="${IDLE_STOP_SECONDS:-1800}"

# Web role only. ';'-separated: --set-env-vars splits its value on commas.
OUTFITTER_OPERATORS="${OUTFITTER_OPERATORS:-mgm@mgms.eu;matej@mgms.eu}"

# access.sh only (never the routine deploy): who IAP admits to outfitter-api, and the custom OAuth
# client that lets members outside the mgmonteleone.com org sign in (README.md "IAP access for
# users outside the org"; the client secret is in Secret Manager).
IAP_MEMBERS="${IAP_MEMBERS:-domain:mgmonteleone.com,domain:serviam-it.hr,user:matija.turk@gmail.com}"
IAP_OAUTH_CLIENT_ID="${IAP_OAUTH_CLIENT_ID:-97916961297-ul9tkt3hh0l8i16imltqcarfrkat1k17.apps.googleusercontent.com}"
