# kernal configuration. Easiest: run `kernal login` — it signs this machine in to Outfitter, which
# then delivers this device's own router key and your settings; your personal keys live in your
# account (web app → Account). Nothing below is needed then except a local model server.
# Signed out, or for a machine-only setup: start `kernal` and run /setup, or copy this file to .env
# next to it and edit. Lines starting with # are ignored.
#
# Keys in this file are deprecated once you are signed in: `kernal login` offers to upload each
# personal key to your account and remove it from here (it keeps a backup, .env.bak-<time>).

# --- Who you are (shown in the banner; Matthew → MGM, Matej → MATEK, others → initials) ---
# KERNAL_USER (was MGM_USER; the old name still works but is deprecated, see docs/rename.md)
KERNAL_USER=

# --- Your local model server (LM Studio, or any OpenAI-compatible server on this machine) ---
# The agent lists whatever the server offers; LMSTUDIO_MODEL is only the default pick.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=qwen/qwen3.6-35b-a3b
# Cap on the context window the agent budgets against (LM Studio reports the served window itself).
LMSTUDIO_CONTEXT=131072

# --- The LiteLLM router (cloud models: Claude, Gemini, GPT) ---
# `kernal login` gives this device its own router key, so its spend is yours; leave LITELLM_AGENT_KEY
# empty then (a key here would win over the device key). Hand-issued shared keys are being retired.
LITELLM_BASE_URL=https://router.kernal.one/v1
LITELLM_AGENT_KEY=

# --- OpenRouter (your own account: https://openrouter.ai/keys; signed in, keep it in your account) ---
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# Optional: models to offer, comma-separated (default: a curated list)
# OPENROUTER_MODELS=anthropic/claude-sonnet-5,openai/gpt-5.5

# --- Voice (pi-listen): live streaming via Deepgram when a key is present; otherwise a local model ---
DEEPGRAM_API_KEY=

# --- Outfitter (optional): `kernal login` signs in to https://link.kernal.one ---
# (Dongles, OUTFITTER_TOKEN, are retired: Kernal ignores one and says "run kernal login")
# OUTFITTER_API=              only to sign in to another Outfitter's link service

# --- Only needed on the machine that publishes its local model to the router (Matthew's) ---
# LITELLM_API_KEY=            general-purpose router key for chat.mjs / scripts
# LOCAL_TUNNEL_TOKEN=         bearer token ngrok enforces in front of LM Studio
# TUNNEL_DOMAIN_LMSTUDIO=     stable ngrok domain (paid plan)
