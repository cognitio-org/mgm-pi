# Browser IDE spike S1 (issue #240): the production agent image plus code-server, to measure what
# baking it in costs a cold start. ADD unpacks a local tarball without running anything, so this
# builds for linux/amd64 on any machine with no emulation. Not for production.
ARG BASE
FROM ${BASE}
ADD code-server-4.139.1-linux-amd64.tar.gz /opt/
