{
  "name": "@outfitter/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Outfitter fleet web UI: fleet list, session view, new session dialog. Built to dist/ and served by packages/api's static route.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run typecheck",
    "test": "vitest run",
    "record-tour": "node scripts/record-tour.mjs",
    "test:live": "node --test --test-timeout=900000 live/app.live.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@sentry/react": "11.2.0",
    "hast-util-to-text": "^4.0.2",
    "highlight.js": "~11.11.0",
    "lowlight": "^3.3.0",
    "mermaid": "^12.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.0",
    "remark-gfm": "^4.0.1",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@sentry/bundler-plugins": "11.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
