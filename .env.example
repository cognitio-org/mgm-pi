# Copy to .env and fill in. Pick a provider with: PROVIDER=lmstudio|litellm|openrouter

# --- Your cloud LiteLLM proxy ---
LITELLM_BASE_URL=https://litellm.augment-code.support/v1
LITELLM_API_KEY=sk-...
# Key used by the mgm agent (~/localllm/mgm); may be on a different LiteLLM team than LITELLM_API_KEY
LITELLM_AGENT_KEY=
LITELLM_MODEL=local-qwen-mlx

# --- OpenRouter ---
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# --- Local (LM Studio, MLX) ---
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=qwen/qwen3.6-35b-a3b
# Cap on the context window pi budgets against for LM Studio models. The served window is discovered
# from LM Studio's /api/v0/models (Qwen 3.6 loads at 183k; KV cache ~2.5 GB at 128k). Empty = no cap.
LMSTUDIO_CONTEXT=131072

# Stable ngrok domains (paid plan; auto-reserved on first use). Change the names if taken.
TUNNEL_DOMAIN_LMSTUDIO=mgm-lmstudio.ngrok.app
