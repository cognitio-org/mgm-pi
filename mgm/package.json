{
  "name": "mgm",
  "private": true,
  "type": "module",
  "description": "mgm coding agent (built on pi) with a /connect command for LM Studio (MLX), the LiteLLM router, or OpenRouter",
  "scripts": {
    "start": "./bin/mgm",
    "models": "./bin/mgm --list-models",
    "test": "node --import ./tests/resolve-pi.mjs --test tests/",
    "test:e2e": "MGM_E2E=1 node --import ./tests/resolve-pi.mjs --test tests/e2e.test.ts",
    "test:coverage": "node --import ./tests/resolve-pi.mjs --test --experimental-test-coverage --test-coverage-include='.pi/extensions/**/*.ts' tests/"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1"
  }
}
