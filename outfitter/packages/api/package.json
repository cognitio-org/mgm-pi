{
  "name": "@outfitter/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Outfitter control-plane API: REST + SSE for the browser, WebSocket ingress for agentd, run lifecycle, secrets broker",
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "pretest": "npm run typecheck",
    "test": "node --test 'test/*.test.ts'"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.1",
    "@google-cloud/run": "^4.1.1",
    "@mongodb-js/agent-engine-sdk-memory": "0.11.7",
    "@octokit/rest": "^22.0.1",
    "@outfitter/provider-local": "^0.1.0",
    "@sentry/node": "11.3.0",
    "@sentry/profiling-node": "11.3.0",
    "fastify": "^5.12.5",
    "google-auth-library": "^11.1.0",
    "mongodb": "^7.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "mongodb-memory-server": "^11.3.0",
    "typescript": "^5.7.0"
  }
}
