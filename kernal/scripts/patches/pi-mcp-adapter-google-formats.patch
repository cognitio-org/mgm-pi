+/**
+ * The formats Google's MCP servers (*.googleapis.com/mcp) put in their tool schemas, from Google's
+ * API Discovery format list. Without them Ajv logs "unknown format ... ignored" for every Google
+ * tool schema it compiles. Only google-duration ("3.5s") is checked; the rest are accepted as is.
+ */
+function addGoogleFormats(ajv: Ajv): void {
+  ajv.addFormat("google-duration", /^-?\d+(\.\d{1,9})?s$/);
+  for (const name of ["google-datetime", "google-fieldmask", "uint32", "uint64"]) ajv.addFormat(name, true);
+}
