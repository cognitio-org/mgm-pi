{
  "name": "@outfitter/agentd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/src/main.js",
  "bin": {
    "agentd": "dist/src/main.js"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "postbuild": "chmod +x dist/test/fake-pi.js",
    "pretest": "npm run build",
    "test": "node --test 'dist/test/*.test.js'",
    "dev:fake-api": "npm run build && node dist/dev/fake-api.js"
  },
  "dependencies": {
    "@sentry/node": "11.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
