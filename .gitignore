# secrets
.env
# tooling state
.omc/
node_modules/
# pi agent runtime state (installed packages, sessions, caches, credentials)
kernal/.pi/npm/node_modules/
kernal/pi/
kernal/dist/
kernal/.pi/sessions/
# personal subagents (pi-subagents' user scope is $PI_CODING_AGENT_DIR/agents, which in a checkout is
# inside the repo); a release bundle links the same directory to ~/.kernal/state/agents
kernal/.pi/agents/
kernal/.pi/mcp-cache.json
kernal/.pi/models-store.json
kernal/.pi/auth.json
kernal/.pi/trust.json
kernal/.pi/pi-tui-crash.log
kernal/.pi/bin/
# code index data (keep the config)
.codebase-index/*
!.codebase-index/config.json
kernal/.pi/web-search-cache/
# stray pi agent dirs / credential stores
pi-agent/
**/.pi/auth.json
kernal/.pi/bug-reports/
# codebase index state (rebuilt on demand)
.codebase-index/index/
**/.opencode/
